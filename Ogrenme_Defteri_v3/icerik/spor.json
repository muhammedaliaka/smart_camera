{
  "paket": "spor",
  "ad": "Spor",
  "surum": 1,
  "hareketler": [
    {
      "id": "sandalye",
      "ad": "Sandalyeye otur-kalk",
      "gorsel": "gorsel/spor/chair.svg",
      "adimlar": [
        "Sağlam bir sandalyeyi duvara daya; kaymadığından emin ol.",
        "Ayakların yerde ve omuz genişliğinde olsun.",
        "Yavaşça otur, sonra ayağa kalk. Oturmayı 2 saniyede yap.",
        "Gerekirse elinle destek al ve bunu not et."
      ],
      "uyari": "Sandalye kayıyorsa ya da başın dönüyorsa dur."
    },
    {
      "id": "duvar-sinav",
      "ad": "Duvar şınavı",
      "gorsel": "gorsel/spor/wall.svg",
      "adimlar": [
        "Duvara bir adım uzakta dur. Ellerini omuz hizasında duvara koy.",
        "Vücudunu düz tut; dirsekleri bükerek göğsünü duvara yaklaştır.",
        "Dirsekleri açarak geri it.",
        "Ayaklarını duvardan uzaklaştırmak zorlaştırır; bu hafta yakın dur."
      ],
      "uyari": "Omuzda ya da bilekte ağrı olursa bırak."
    },
    {
      "id": "kalca-kopru",
      "ad": "Kalça köprüsü",
      "gorsel": "gorsel/spor/bridge.svg",
      "adimlar": [
        "Sırtüstü yat; dizlerini bük, ayaklarını yere bas.",
        "Kalçanı rahatça kaldır; omuzdan dize düz bir çizgi olsun.",
        "Bir saniye bekle, yavaşça indir.",
        "Belini fazla çukurlaştırma."
      ],
      "uyari": "Belinde ağrı varsa daha az kaldır ya da bırak."
    },
    {
      "id": "cekis-prova",
      "ad": "Çekiş provası",
      "gorsel": "gorsel/spor/row.svg",
      "adimlar": [
        "Dik bir sandalyede otur; gövden dik, kollar önde uzatılmış.",
        "Dirsekleri yavaşça gövdenin yanına çek.",
        "Yavaşça geri bırak.",
        "Bu bir kuvvet testi değil; hareketin sırasını öğrenme provasıdır."
      ]
    },
    {
      "id": "denge-turu",
      "ad": "Denge turu",
      "birim": "tur",
      "gorsel": "gorsel/spor/balance.svg",
      "adimlar": [
        "Sağlam bir desteğin (duvar, masa) yanında dur.",
        "Bir ayağını diğerinin tam önüne koy (tek çizgi gibi). Üç rahat nefes boyunca dur.",
        "Ayak değiştir ve tekrarla.",
        "Sonra tek ayak üstünde üç nefes dene. Destek almak serbest."
      ],
      "uyari": "Her zaman tutunabileceğin bir şey yanında olsun."
    },
    {
      "id": "ceviklik-turu",
      "ad": "Çeviklik turu",
      "birim": "tur",
      "gorsel": "gorsel/spor/steps.svg",
      "adimlar": [
        "Yere hayalî bir çizgi çiz (ya da bir ip ser).",
        "Çizginin sağına, sonra soluna kontrollü beşer adım at.",
        "Zıplamak ya da yarışmak gerekmez; adımların düzgün olsun."
      ],
      "uyari": "Yer kaygan ya da dağınıksa bu turu yapma."
    }
  ],
