{
  "max_file_bytes": 30720,
  "size_ignore": [
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.ico",
    "*.pdf",
    "*.zip",
    "*.mp3",
    "*.wav",
    "*.ogg",
    "*.mp4",
    "*.fbx",
    "*.glb",
    "*.gltf",
    "*.blend",
    "*.unity",
    "*.prefab",
    "*.asset",
    "*.mat",
    "*.meta",
    "*.anim",
    "*.controller",
    "*.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "*.min.js",
    "*.min.css",
    "*.map"
  ],
  "plan_globs": [
    ".pusula/*/plan.md",
    "docs/plans/*.md"
  ],
  "plan_required_labels": [
    "Why code:",
    "Checked:"
  ],
  "plan_checked_pattern": "https?://|ran in this session|UNVERIFIED",
  "plan_label_lookback_lines": 4,
  "plan_coverage_headings": [
    "User experience",
    "Correctness and logic",
    "Security",
    "Cost and tokens",
    "Source quality",
    "Tests",
    "License and legal",
    "Scope and time",
    "Maintenance",
    "Tool compatibility",
    "Delivery",
    "Conflicts"
  ],
  "fail_severities": [
    "ERROR",
    "WARNING"
  ],
  "max_findings_per_check": 10,
  "semgrep_rules": "semgrep/hardcode.yml",
  "semgrep_rulesets": [
    "p/default"
  ],
  "complexity_max": 10,
  "complexity_ignore": [
    "*/node_modules/*",
    "*/Library/*",
    "*/Packages/*",
    "*/ThirdParty/*",
    "*/vendor/*",
    "*/target/*",
    "*/.pusula/*"
  ],
  "architecture_file": ".pusula/architecture.md",
  "license_allow": [],
  "license_presets": {
    "permissive": [
      "MIT",
      "MIT-0",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "0BSD",
      "Zlib",
      "BSL-1.0",
      "Unlicense",
      "CC0-1.0"
    ]
  },
  "after_compact_max_bytes": 3000,
  "shield": {
    "project_config": ".pusula/shield.config.json",
    "stacks": [
      "unity",
      "web",
      "electron",
      "flutter",
      "dotnet",
      "other"
    ],
    "value_classes": [
      "ai",
      "economy",
      "network",
      "content"
    ],
    "required_keys": [
      "stack",
      "release_dir",
      "classes",
      "budgets"
    ],
    "optional_keys": [
      "exclude"
    ],
    "budget_keys": [
      "max_size_growth_pct",
      "max_startup_ms_growth",
      "max_frame_ms_growth",
      "max_recall_pct"
    ],
    "leak_files": {
      "*.map": "source map",
      "*.pdb": "debug symbols",
      ".env": "environment secrets",
      ".env.*": "environment secrets"
    },
    "source_map_globs": [
      "*.map"
    ],
    "map_source_key": "sourcesContent",
    "leak_text": {
      "*.js": "sourceMappingURL=",
      "*.css": "sourceMappingURL="
    },
    "leak_text_tail_bytes": 2048,
    "plain_metadata": {
      "global-metadata.dat": {
        "magic_hex": "AF1BB1FA",
        "why": "plain IL2CPP metadata, names and strings readable by dumpers"
      }
    },
    "report": {
      "min_length": 3,
      "unclassified": "(unclassified)",
      "size_budget": "max_size_growth_pct",
      "growth_kind": {
        "max_size_growth_pct": "pct",
        "max_startup_ms_growth": "abs",
        "max_frame_ms_growth": "abs"
      },
      "extractors": {
        "analyze_javascript_application": {
          "nodes": [
            "normalized_result",
            "semantic_graph",
            "nodes"
          ],
          "path": [
            "identity",
            "module_path"
          ],
          "kinds": {
            "literal": {
              "value": [
                "properties",
                "value"
              ]
            },
            "function": {
              "value": [
                "properties",
                "name"
              ]
            },
            "binding": {
              "value": [
                "label"
              ]
            },
            "property-slot": {
              "value": [
                "properties",
                "name"
              ],
              "where": {
                "path": [
                  "properties",
                  "presence"
                ],
                "equals": "present"
              }
            }
          }
        }
      }
    }
  },
  "tools": {
    "semgrep": {
      "exe": "semgrep",
      "install": "uv tool install semgrep"
    },
    "gitleaks": {
      "exe": "gitleaks",
      "install": "see https://github.com/gitleaks/gitleaks#installing"
    },
    "osv": {
      "exe": "osv-scanner",
      "install": "see https://github.com/google/osv-scanner#installation"
    },
    "lizard": {
      "exe": "lizard",
      "install": "uv tool install lizard"
    }
  }
}
